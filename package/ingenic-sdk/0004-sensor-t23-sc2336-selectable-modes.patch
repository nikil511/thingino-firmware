+			ret = sensor_write(sd, v->reg_num, v->value);
+			if (ret)
+				return ret;
+		}
+		ret = sensor_write_window(sd);
+		if (!ret)
+			ret = sensor_write_array(sd, sensor_stream_on_mipi);
+	} else {
+		ret = sensor_write_array(sd, wsize->regs);
+	}
